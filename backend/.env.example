# Laura Fancy Store — Backend Environment Configuration Example
# Copy to .env and fill in real secrets (DO NOT COMMIT .env TO GIT)

# Port Configurations (Optional Defaults)
GATEWAY_PORT=8080
AUTH_PORT=8081
PRODUCT_PORT=8082
CATEGORY_PORT=8083

# Security & Authentication
# Generate a strong 256-bit random string for production
JWT_SECRET=your-strong-production-jwt-secret-here

# CORS Allowed Origins (Comma-separated for multiple domains)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,https://your-store.vercel.app

# Email Service Configuration for Admin 2FA OTP Delivery
# Option 1: Resend API Key (https://resend.com)
RESEND_API_KEY=
RESEND_FROM=Laura Fancy Store <onboarding@resend.dev>

# Option 2: Brevo API Key (https://brevo.com)
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=Laura Fancy Store

# Option 3: SMTP (e.g. Gmail App Password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
